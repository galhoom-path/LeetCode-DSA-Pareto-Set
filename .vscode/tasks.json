{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run: current .c++ file",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/run.ps1",
        "-File",
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Run: #1 Brute",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/run.ps1",
        "-Problem",
        "01",
        "-Approach",
        "1"
      ],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run: #1 Optimized",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/run.ps1",
        "-Problem",
        "01",
        "-Approach",
        "2"
      ],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run: #1 Optimal",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/run.ps1",
        "-Problem",
        "01",
        "-Approach",
        "3"
      ],
      "problemMatcher": ["$gcc"]
    }
  ]
}
